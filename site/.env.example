# Every environment variable this site reads. Copy to .env.local and fill in.
# .env.local is gitignored; the real production values live in the Railway
# service variables, not in this repository.
#
# For local work you need none of these — the site runs without them, storing
# content in JSON files and printing email instead of sending it. Set them only
# when you need to exercise the real thing.

# -----------------------------------------------------------------------------
#  Storage
# -----------------------------------------------------------------------------
# Postgres. Railway injects this automatically for the deployed service.
# LEAVE IT EMPTY LOCALLY — a real value here writes to the live database.
DATABASE_URL=

# Where the JSON-file fallback keeps its data when DATABASE_URL is empty.
# Defaults to ./.data. Point it somewhere temporary for tests.
DATA_DIR=

# -----------------------------------------------------------------------------
#  Admin dashboard
# -----------------------------------------------------------------------------
# The password for /admin. Without it the site falls back to a built-in default
# and shows a warning inside the dashboard.
ADMIN_PASSWORD=

# Long random string that signs the admin session cookie and the expiring
# download links. Set this in production: without it the key is derived from
# ADMIN_PASSWORD, and without that too it is random per process, so everyone is
# signed out and outstanding download links stop working on every restart.
ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
#  Email (Resend)
# -----------------------------------------------------------------------------
# Leave RESEND_API_KEY empty to disable sending. Submissions are still saved to
# the Inbox and the message is logged instead of delivered.
RESEND_API_KEY=

# Where contact-form submissions go. Comma-separate for several recipients.
CONTACT_TO_EMAIL=

# Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# -----------------------------------------------------------------------------
#  Public / SEO
# -----------------------------------------------------------------------------
# The site's own address, used for canonicals, sitemap entries, and share tags.
# Defaults to the production domain.
NEXT_PUBLIC_SITE_URL=

# Google Analytics measurement ID. Leave empty to load no analytics.
NEXT_PUBLIC_GA_ID=

# Key for IndexNow ping-on-publish. Leave empty to skip the ping.
INDEXNOW_KEY=
